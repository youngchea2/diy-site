{
  // wrangler.jsonc : Cloudflare 배포 설정
  "name": "diy-site",
  "main": "src/worker.js",              // 로그인/회원 처리 서버 코드
  "compatibility_date": "2025-09-09",
  "assets": {
    "directory": "./public",            // 사이트 파일 폴더
    "binding": "ASSETS",                // 서버 코드에서 사이트 파일을 꺼낼 때 쓰는 이름
    // 아래 주소는 서버 코드를 먼저 거치게 함 (나머지는 정적 파일 그대로 제공)
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",                  // 서버 코드에서 env.DB 로 사용
      "database_name": "diy-site-db",
      // ★ Cloudflare 대시보드에서 만든 D1 의 Database ID 로 바꾸세요
      "database_id": "41f046b3-765b-42ea-a788-9d966e92ae59"
    }
  ]
  // 카카오 REST API 키는 이 파일에 쓰지 않습니다! (대시보드의 Secret 으로 등록)
}
